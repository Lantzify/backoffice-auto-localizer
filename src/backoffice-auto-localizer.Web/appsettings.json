{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "459a2e86-1f5f-48f3-8dcc-2864108b178e",
        "UseHttps": true,
        "SanitizeTinyMce": true
      },
      "Content": {
